# Bean API base (без завершающего /)
# Локально (MSW): /api/v1/bean — запросы на localhost, моки в handlers.ts
# Живой CMS: https://music.mastermindcms.com/api/v1/bean
VITE_API_BASE_URL=/api/v1/bean

# App base path: / or /music-store-project/ for example
VITE_APP_BASE_URL=/

# Force MSW worker (true for local mocks / e2e; false for live CMS)
VITE_ENABLE_MSW=true

# --- Живой бекенд (приложение + Storybook ApiSwagger) ---
# В .env:
#   VITE_API_BASE_URL=https://music.mastermindcms.com/api/v1/bean
#   VITE_ENABLE_MSW=false
# Затем перезапустите `npm run storybook` (env подхватывается при старте).
# Story: App/API (Swagger) → Explorer → секция CMS Playlists (шаги 1→2→3).
# Если base абсолютный (https://…), MSW в этой story отключается автоматически.
