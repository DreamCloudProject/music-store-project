# Bean API base (без завершающего /)
# Локально (MSW): /api/v1/bean — запросы на localhost, моки в handlers.ts
# Прод / CMS: https://music.mastermindcms.com/api/v1/bean
VITE_API_BASE_URL=/api/v1/bean

# App base path: / or /music-store-project/ for example
VITE_APP_BASE_URL=/

# Force MSW worker (true for local mocks / e2e; omit or false for live CMS)
VITE_ENABLE_MSW=true
